SERVICE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
REDIS_URL=redis://localhost:6379
SERVER_DOMAIN=nsl.sh

# SendGrid API key for the per-user mail relay (POST /email/send).
# The mail-gateway running on each PCS forwards app emails here; this backend
# verifies the caller's identity and sends from <app>.<user-domain>@SERVER_DOMAIN
# (e.g. vaultwarden.john@nsl.sh). The SendGrid sending domain MUST be SERVER_DOMAIN,
# authenticated with DKIM/SPF/DMARC on that zone. When unset, sends are skipped (logged).
SENDGRID_API_KEY=

# TTL for route entries in seconds (default: 600 = 10 minutes)
# Routes expire if not refreshed within this time.
# Agent refreshes every 300s, so 600s provides buffer for missed heartbeats.
ROUTES_TTL_SECONDS=600
# Nameserver hidden primary (mesh-router-nameserver deploy/primary). Both unset = off.
# The backend keeps the ip.<zone> allowlist zone (allow.<DNS_IP_ZONE>.invalid) equal to
# the public IPs agents registered within DNS_ALLOW_GRACE_SECONDS (default 21600 = 6 h).
# PDNS_API_URL=http://pdns-primary:8081
# PDNS_API_KEY=
# DNS_IP_ZONE=ip.nsl.sh
# DNS_ALLOW_GRACE_SECONDS=21600
# DNS_CATALOG_ZONE=catalog.<SERVER_DOMAIN>.invalid
